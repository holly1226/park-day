{
  "name": "park-day",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A pixel park observatory powered by real AVA queries.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "ai": "node --env-file-if-exists=.env scripts/ai-server.mjs",
    "postinstall": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@antv/ava": "4.0.4",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "ava-engine-duckdb-wasm": "0.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=24"
  }
}
